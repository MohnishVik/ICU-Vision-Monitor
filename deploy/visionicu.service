[Unit]
Description=VisionICU Patient Monitoring System
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/jetson/icu-vision-monitor
ExecStart=/usr/bin/python3 main.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
